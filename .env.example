ANTHROPIC_API_KEY=your_api_key_here

# Which LLM the Planner/Writer/Critic use. The Researcher always uses
# Claude directly (it needs Claude's built-in web search).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Only needed if you set LLM_PROVIDER=openai above
OPENAI_API_KEY=your_openai_api_key_here
